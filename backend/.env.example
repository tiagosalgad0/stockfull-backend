# copie este arquivo para ".env" e preencha com os valores de cada ambiente
# no servidor online, essas mesmas variáveis são configuradas direto no painel
# do serviço de hospedagem, sem precisar deste arquivo

# gere uma chave nova só para produção, nunca reaproveite a de desenvolvimento
SECRET_KEY=troque-por-uma-chave-gerada-so-para-producao
DEBUG=False
ALLOWED_HOSTS=seu-dominio.com

# se o serviço de hospedagem já fornecer um endereço pronto de banco, cole aqui e
# ignore as quatro variáveis DB_ abaixo
DATABASE_URL=

DB_NAME=db_stockfull
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://seu-frontend.com
CSRF_TRUSTED_ORIGINS=https://seu-frontend.com
